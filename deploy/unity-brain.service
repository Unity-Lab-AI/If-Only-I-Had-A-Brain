# Unity brain-server — systemd unit (PA.4.7). Operator deploy reference.
#
# The persistent, always-on stateful backend. It holds the brain weights +
# memory and orchestrates the donated-GPU compute pool. Donors (remote
# browsers running compute.html) + the operator connect to it via nginx (see
# nginx-unity-brain.conf). Binds localhost only — ALL external access flows
# through the nginx vhost, which is where Forgejo auth + the public/admin
# split live.
#
# Install:
#   sudo cp deploy/unity-brain.service /etc/systemd/system/
#   (edit User / WorkingDirectory / paths below to match the box)
#   sudo systemctl daemon-reload && sudo systemctl enable --now unity-brain
#   sudo systemctl status unity-brain   # verify
#   journalctl -u unity-brain -f        # tail logs

[Unit]
Description=Unity brain-server (distributed-compute brain backend)
After=network-online.target
Wants=network-online.target
# STOPTRAP.1 — NEVER give up on the brain. The default rate limiter (5 starts
# in 10s, then "start request repeated too quickly" and the unit stays dead)
# is a SECOND way to strand a box whose operator has no shell: a boot-time
# crash loop would exhaust the budget in under a minute and then never retry,
# with no dashboard left to press. 0 disables the limiter, so RestartSec=5
# keeps retrying forever and a fixed overlay recovers on its own.
StartLimitIntervalSec=0

[Service]
Type=simple
# Run as a non-root service user that owns the repo checkout.
User=unity
WorkingDirectory=/opt/unity-brain
ExecStart=/usr/bin/node server/brain-server.js

# PA.4.2 + PA.4.8 environment:
#   UAL_PROXY_AUTH=1  → admin gated on the proxy-vouched X-UAL-User header
#                       (loopback no longer implies admin behind the proxy).
#   BRAIN_BIND        → localhost only; nginx is the sole external entry.
Environment=UAL_PROXY_AUTH=1
Environment=BRAIN_BIND=127.0.0.1
Environment=NODE_ENV=production
# Headless box: don't auto-launch a local Chrome GPU client — donors bring
# the GPUs. (compute.html donors connect over the network.)
Environment=DREAM_NO_AUTO_GPU=1
# Preserve the in-progress curriculum walk across crash/incidental restarts — a
# multi-week walk must NOT be wiped by a restart. autoClearStaleState opts out
# under this flag. A PA.4.8 milestone RESIZE clears the old-size weights itself
# (server/brain-server/gpu.js) so it still re-walks fresh at the new tier; this
# flag only protects against losing training on an incidental restart.
Environment=DREAM_KEEP_STATE=1
# DF.7 multi-GPU fan-out: round-robin teach-Hebbian WRITES across ALL donors (not
# just the primary) + promote the strongest newcomer. Default-on in code; explicit
# here. (DREAM_DF7_FANOUT_PROPAGATE stays UNSET/off — fanning READS off a not-yet-
# synced replica can fail a gate; only enable after replica sync is proven clean.)
Environment=DREAM_DF7_FANOUT=1
# Chunked sparse-matrix upload timeout. The size-scaled default (payload at
# DREAM_UPLOAD_MIN_MBPS + margin, capped 30min) governs — an explicit env here
# acts as a FLOOR-RAISED minimum for slow links (Starlink-class), and since the
# 2026-08-16 fix it can never LOWER the deadline below what the payload
# physically needs at the wire rate. The old hard 180000 starved the 12M
# language cortex's ~2.9GB intra upload (~12min at the real wire) into a
# timeout-retry loop; the line is removed so the scaled deadline governs.
# Environment=DREAM_SPARSE_UPLOAD_TIMEOUT_MS=180000

Restart=always
RestartSec=5
# STOPTRAP.1 — the deliberate-halt sentinel. server/brain-server.js has cited
# this directive by name since the /shutdown handler was written, but the
# directive itself was never in this file — the code documented a contract the
# unit did not carry. Exit 42 means a human asked for a TRUE halt (stop.bat or
# the localhost-only Stop button); every other exit is an incident and gets
# revived. The dashboard's savestart path (/restart) deliberately exits 0 so
# that it IS revived, which is what makes it a savestart.
RestartPreventExitStatus=42

# ── Resource caps — SHARED BOX (Forgejo + all the lab's git run here too).
# Keep the brain under ~75% of the host (the lab box is 8c/16t · 32 GB) so it
# can NEVER peg the CPU or OOM the box and take Forgejo down. These are cgroup-
# enforced by systemd, independent of any in-app sizing: if the brain ever
# exceeds MemoryMax it is OOM-killed ALONE (the box + Forgejo survive) and
# systemd restarts it (DREAM_KEEP_STATE=1 resumes the walk). The in-app budget
# (DREAM_BRAIN_BUDGET_MB / the RAM-safe auto-cap) sizes the brain well under
# these so the hard cap is only a backstop. Tune the numbers to the box.
# IMPORTANT: systemd does NOT support inline (end-of-line) comments on
# directive lines — `MemoryMax=24G  # note` parses the value as "24G  # note",
# fails validation, and SILENTLY IGNORES the cap (the limit becomes infinity).
# Keep every comment on its OWN line, never after a directive.
MemoryAccounting=true
CPUAccounting=true
# soft limit — kernel reclaims aggressively above this
# RAISED 20G -> 22G on the operator's decision, against measured arithmetic
# rather than a hunch. The in-app budget derives from HOST RAM: 31,831 total
# minus the 13,312 Forgejo/OS reserve = 18,519 MB of weights, and the measured
# non-weights overhead (V8 heap, buffers, corpus) is ~2,867 MB — so RSS lands at
# ~21.4 GB, which was 906 MB OVER the old 20G soft limit. She was throttled by a
# ceiling the sizing could not see, and two independent records agree on the
# number: the board's 21.3 GB reading and self-update.sh's own note that the
# cgroup sat "pinned exactly at MemoryHigh=20G".
# At 22G the HOST reserve binds again, which is how this was designed to work,
# and she keeps all 411,216,550 neurons. The alternative — leaving 20G and
# sizing down to fit — cost 20,117,835 neurons (-4.9%).
# ⚠ This leaves 9,303 MB of host for Forgejo + OS at peak, against a MEASURED
# ~4,000 MB of actual non-brain usage. MemoryMax stays 24G, so the OOM backstop
# that protects Forgejo is unchanged: the brain still dies alone.
# ⛔ The one number still unmeasured is the peak during a Forgejo Actions Rust
# cross-build on donor-release day. If that is ever measured and exceeds ~9 GB,
# this is the directive to reconsider first.
MemoryHigh=22G
# HARD cap (~75% of 32 GB) — brain OOM-killed alone if exceeded; box + Forgejo survive
MemoryMax=24G
# <=12 of 16 threads — always leaves cores for Forgejo + OS
CPUQuota=1200%
# V8 heap <=16 GB (off-heap ArrayBuffers are still counted by MemoryMax)
Environment=NODE_OPTIONS=--max-old-space-size=16384

# Hardening
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
